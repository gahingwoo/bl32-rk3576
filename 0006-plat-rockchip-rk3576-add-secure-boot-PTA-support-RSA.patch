From 38b18cd2b7d484def9a2b1cc5f78df9818d09151 Mon Sep 17 00:00:00 2001
From: Jiaxing Hu <huhuvmb88@outlook.com>
Date: Sat, 6 Jun 2026 14:15:59 +1200
Subject: [PATCH 6/6] plat-rockchip: rk3576: add secure boot PTA support
 (RSA-2048)

Add CFG_RK_SECURE_BOOT support for RK3576 with the following OTP layout
(cross-referenced against Rockchip vendor U-Boot secure OTP driver):

  Status word : OTP_S word 0x8  (bytes [32, 33])
  RSA key hash: OTP_S words 0x184-0x187 (bytes [1552, 1567])
                SHA-256 of RSA-2048 public key, 4 x 32-bit words

RK3576 supports RSA-2048 only (no RSA-4096 status fuse).
CFG_RK_SECURE_BOOT_SIMULATION defaults to y; set it to n to actually
fuse the hash (irreversible, may brick the device).

Also fix rk_secure_boot.c to support variable RSA hash sizes:
- Remove static_assert(ROCKCHIP_OTP_RSA_HASH_SIZE == 8) hardcoded size
- Make HASH_STRING_SIZE dynamic (RSA_HASH_SIZE * 11 + 1)
- Make otp_to_string() accept an explicit count parameter
- Gate write_key_size() RSA-4096 path on
  #ifdef ROCKCHIP_OTP_SECURE_BOOT_STATUS_RSA4096 so platforms that
  only support RSA-2048 compile without the unreachable branch
- Fix write_hash(): return TEE_ERROR_GENERIC instead of TEE_SUCCESS
  when the readback verification fails
- Fix lockdown_device(): use assignment instead of OR when writing the
  enable status (avoids accidental RSA4096 fuse if status was dirtied)
- Use MIN() for memcpy sizes across hash structs of different sizes

Tested on Radxa Rock 4D (RK3576, 12 GiB LPDDR5) with simulation=y:
PTA registers correctly, xtest 113/1 (baseline unchanged).

Co-developed-by: the-gabe <105918853+the-gabe@users.noreply.github.com>
Signed-off-by: Jiaxing Hu <huhuvmb88@gmail.com>
---
 core/arch/arm/plat-rockchip/conf.mk           |  6 ++
 core/arch/arm/plat-rockchip/platform_config.h | 15 +++++
 core/pta/rockchip/rk_secure_boot.c            | 66 +++++++++++++------
 3 files changed, 68 insertions(+), 19 deletions(-)

diff --git a/core/arch/arm/plat-rockchip/conf.mk b/core/arch/arm/plat-rockchip/conf.mk
index 739f21194..f4b01a6a4 100644
--- a/core/arch/arm/plat-rockchip/conf.mk
+++ b/core/arch/arm/plat-rockchip/conf.mk
@@ -100,6 +100,12 @@ CFG_SHMEM_SIZE   ?= 0x00400000
 # provisioning) is gated by CFG_RK3576_PERSIST_HUK which defaults to n.
 $(call force,CFG_ROCKCHIP_OTP,y)
 
+CFG_RK_SECURE_BOOT ?= y
+# Disable CFG_RK_SECURE_BOOT_SIMULATION to actually fuse the RSA key hash
+# into OTP.  Enabling this is necessary to activate secure boot but is
+# irreversible and may brick the device if the wrong key hash is burned.
+CFG_RK_SECURE_BOOT_SIMULATION ?= y
+
 # RKRNG_S hardware TRNG (0x2a440000).
 # Set CFG_RK3576_RKRNG=y to provide hw_get_random_bytes() using real hardware
 # entropy.  When enabled, plat_get_random_stack_canaries() is also overridden
diff --git a/core/arch/arm/plat-rockchip/platform_config.h b/core/arch/arm/plat-rockchip/platform_config.h
index 984f2861b..c91e03c91 100644
--- a/core/arch/arm/plat-rockchip/platform_config.h
+++ b/core/arch/arm/plat-rockchip/platform_config.h
@@ -170,6 +170,21 @@
 #define ROCKCHIP_OTP_HUK_INDEX		0x80	/* RK3576 confirmed; RK3588 uses 0x104 */
 #define ROCKCHIP_OTP_HUK_SIZE		0x4	/* 4 words = 16 bytes */
 
+/*
+ * Secure Boot OTP layout (cross-referenced against Rockchip vendor U-Boot
+ * secure OTP driver whitelisted byte ranges):
+ *   Status word : OTP_S word 0x8  (bytes [32, 33])
+ *   RSA key hash: OTP_S words 0x184-0x187 (bytes [1552, 1567]) — SHA-256 of
+ *                 the RSA-2048 public key, 4 x 32-bit words (128-bit hash)
+ * RK3576 only supports RSA-2048; no RSA4096 status bit is defined.
+ */
+#define ROCKCHIP_OTP_SECURE_BOOT_STATUS_INDEX	0x8
+#define ROCKCHIP_OTP_SECURE_BOOT_STATUS_SIZE	0x1
+#define ROCKCHIP_OTP_SECURE_BOOT_STATUS_ENABLE	0x00ff
+
+#define ROCKCHIP_OTP_RSA_HASH_INDEX		0x184
+#define ROCKCHIP_OTP_RSA_HASH_SIZE		0x4	/* RSA-2048: 4 words = 16 bytes */
+
 #else
 #error "Unknown platform flavor"
 #endif
diff --git a/core/pta/rockchip/rk_secure_boot.c b/core/pta/rockchip/rk_secure_boot.c
index fe762b5f0..31817ab6b 100644
--- a/core/pta/rockchip/rk_secure_boot.c
+++ b/core/pta/rockchip/rk_secure_boot.c
@@ -29,20 +29,28 @@ static inline bool test_bit_mask(uint32_t value, uint32_t mask)
 	return (value & mask) == mask;
 }
 
-#define HASH_STRING_SIZE 88
-static_assert(ROCKCHIP_OTP_RSA_HASH_SIZE == 8);
-static __maybe_unused char *otp_to_string(uint32_t *otp,
+/* "0x" + 8 hex digits + space = 11 chars per word, plus NUL */
+#define HASH_STRING_SIZE (ROCKCHIP_OTP_RSA_HASH_SIZE * 11 + 1)
+
+static __maybe_unused char *otp_to_string(uint32_t *otp, size_t count,
 					  char *str, size_t str_size)
 {
-	snprintf(str, str_size,
-		 "0x%"PRIx32" 0x%"PRIx32" 0x%"PRIx32" 0x%"PRIx32
-		 " 0x%"PRIx32" 0x%"PRIx32" 0x%"PRIx32" 0x%"PRIx32,
-		 otp[0], otp[1], otp[2], otp[3],
-		 otp[4], otp[5], otp[6], otp[7]);
+	size_t pos = 0;
+	size_t i = 0;
+
+	for (i = 0; i < count && pos < str_size; i++) {
+		int n = snprintf(str + pos, str_size - pos,
+				 "%s0x%"PRIx32, i ? " " : "", otp[i]);
+
+		if (n < 0)
+			break;
+		pos += n;
+	}
 
 	return str;
 }
 
+#ifdef ROCKCHIP_OTP_SECURE_BOOT_STATUS_RSA4096
 static TEE_Result write_key_size(uint32_t key_size_bits)
 {
 	uint32_t idx = ROCKCHIP_OTP_SECURE_BOOT_STATUS_INDEX;
@@ -77,6 +85,19 @@ static TEE_Result write_key_size(uint32_t key_size_bits)
 
 	return res;
 }
+#else
+static TEE_Result write_key_size(uint32_t key_size_bits)
+{
+	switch (key_size_bits) {
+	case 2048:
+		return TEE_SUCCESS;
+	default:
+		EMSG("Key size %"PRId32" not supported on this platform",
+		     key_size_bits);
+		return TEE_ERROR_BAD_PARAMETERS;
+	}
+}
+#endif
 
 static TEE_Result write_hash(uint32_t *hash, size_t size)
 {
@@ -87,7 +108,7 @@ static TEE_Result write_hash(uint32_t *hash, size_t size)
 	if (size != ROCKCHIP_OTP_RSA_HASH_SIZE)
 		return TEE_ERROR_GENERIC;
 
-	IMSG("Burning hash %s", otp_to_string(hash, str, sizeof(str)));
+	IMSG("Burning hash %s", otp_to_string(hash, size, str, sizeof(str)));
 
 	res = rockchip_otp_write_secure(hash,
 					ROCKCHIP_OTP_RSA_HASH_INDEX,
@@ -102,11 +123,11 @@ static TEE_Result write_hash(uint32_t *hash, size_t size)
 		return res;
 	if (memcmp(tmp, hash, sizeof(tmp))) {
 		EMSG("Failed to burn hash. OTP is %s",
-		     otp_to_string(tmp, str, sizeof(str)));
-		return res;
+		     otp_to_string(tmp, ARRAY_SIZE(tmp), str, sizeof(str)));
+		return TEE_ERROR_GENERIC;
 	}
 
-	return res;
+	return TEE_SUCCESS;
 }
 
 static TEE_Result get_info(uint32_t param_types,
@@ -145,12 +166,14 @@ static TEE_Result get_info(uint32_t param_types,
 	if (res)
 		return res;
 
-	DMSG("Current hash: %s", otp_to_string(hash, str, sizeof(str)));
+	DMSG("Current hash: %s", otp_to_string(hash, ARRAY_SIZE(hash),
+					       str, sizeof(str)));
 
 	info->enabled = test_bit_mask(status,
 				      ROCKCHIP_OTP_SECURE_BOOT_STATUS_ENABLE);
 	info->simulation = IS_ENABLED(CFG_RK_SECURE_BOOT_SIMULATION);
-	memcpy(info->hash.value, hash, sizeof(info->hash.value));
+	memcpy(info->hash.value, hash,
+	       MIN(sizeof(info->hash.value), sizeof(hash)));
 
 	return TEE_SUCCESS;
 }
@@ -178,7 +201,8 @@ static TEE_Result burn_hash(uint32_t param_types,
 	hash_sz = params[0].memref.size;
 	if (!hash || hash_sz != sizeof(*hash))
 		return TEE_ERROR_BAD_PARAMETERS;
-	memcpy(new_hash, hash->value, sizeof(new_hash));
+	memcpy(new_hash, hash->value,
+	       MIN(sizeof(new_hash), sizeof(hash->value)));
 
 	key_size_bits = params[1].value.a;
 	if (key_size_bits != 4096 && key_size_bits != 2048) {
@@ -196,9 +220,11 @@ static TEE_Result burn_hash(uint32_t param_types,
 	if (memcmp(old_hash, zero, sizeof(zero)) &&
 	    memcmp(old_hash, new_hash, sizeof(new_hash))) {
 		EMSG("Refusing to burn hash %s",
-		     otp_to_string(new_hash, str, sizeof(str)));
+		     otp_to_string(new_hash, ARRAY_SIZE(new_hash),
+				   str, sizeof(str)));
 		EMSG("OTP hash is %s",
-		     otp_to_string(old_hash, str, sizeof(str)));
+		     otp_to_string(old_hash, ARRAY_SIZE(old_hash),
+				   str, sizeof(str)));
 		return TEE_ERROR_BAD_PARAMETERS;
 	}
 
@@ -219,7 +245,9 @@ static TEE_Result burn_hash(uint32_t param_types,
 
 	if (IS_ENABLED(CFG_RK_SECURE_BOOT_SIMULATION)) {
 		IMSG("Simulation mode: Skip burning hash %s, key size %"PRId32,
-		     otp_to_string(new_hash, str, sizeof(str)), key_size_bits);
+		     otp_to_string(new_hash, ARRAY_SIZE(new_hash),
+				   str, sizeof(str)),
+		     key_size_bits);
 		return TEE_SUCCESS;
 	}
 
@@ -272,7 +300,7 @@ static TEE_Result lockdown_device(uint32_t param_types,
 		return TEE_SUCCESS;
 	}
 
-	status |= ROCKCHIP_OTP_SECURE_BOOT_STATUS_ENABLE;
+	status = ROCKCHIP_OTP_SECURE_BOOT_STATUS_ENABLE;
 
 	if (IS_ENABLED(CFG_RK_SECURE_BOOT_SIMULATION)) {
 		IMSG("Simulation mode: Skip writing status: %"PRIx32,
-- 
